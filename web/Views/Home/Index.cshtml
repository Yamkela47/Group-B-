@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <img src="~/images/cutting-edge-logo.jpeg" alt="Cutting Edge Logo" class="hero-logo" />
        <h1>CUTTING EDGE</h1>
        <p class="hero-subtitle">SALON MANAGEMENT SYSTEM</p>
        <p class="hero-description">
            Manage bookings, stylists, services, schedules and reports — all in one powerful system.
        </p>
        @if (User?.Identity?.IsAuthenticated == true || !string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn-hero">
                Continue to Dashboard
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn-hero">
                Login as Manager / Staff
            </a>
        }
    </div>
</section>

<!-- Feature Cards -->
<section class="features-section">
    <div class="features-grid">

        <div class="feature-card">
            <div class="feature-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
            </div>
            <h3>Manage Bookings</h3>
            <p>Keep your calendar organized and never miss an appointment.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
            </div>
            <h3>Track Revenue</h3>
            <p>Gain insights and grow your business with powerful reports.</p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <h3>Stylist Profiles & Schedule</h3>
            <p>Manage all stylists and their daily working schedules.</p>
        </div>

    </div>
</section>

<!-- Footer tagline -->
<section class="tagline-section">
    <p class="tagline">Our Vision. Your Style.</p>
</section>

<style>
    body {
        background-color: #0d0d0d;
    }

    /* ===== Hero ===== */
    .hero-section {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 20px;
        background: radial-gradient(circle at center, #1a1a1a 0%, #0d0d0d 70%);
    }

    .hero-content {
        max-width: 640px;
    }

    .hero-logo {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        border: 3px solid #d4af37;
        padding: 6px;
        background-color: #1a1a1a;
        margin-bottom: 25px;
    }

    .hero-section h1 {
        color: #d4af37;
        font-size: 48px;
        font-weight: 800;
        letter-spacing: 4px;
        margin: 0;
    }

    .hero-subtitle {
        color: #888;
        font-size: 14px;
        letter-spacing: 6px;
        margin: 10px 0 30px 0;
        text-transform: uppercase;
    }

    .hero-description {
        color: #bbb;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 40px;
    }

    .btn-hero {
        display: inline-block;
        padding: 16px 42px;
        background-color: #d4af37;
        color: #0d0d0d;
        font-size: 16px;
        font-weight: 700;
        border-radius: 10px;
        text-decoration: none;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(212, 175, 55, 0.25);
    }

        .btn-hero:hover {
            background-color: #f0d060;
            transform: translateY(-2px);
            box-shadow: 0 6px 28px rgba(212, 175, 55, 0.4);
            color: #0d0d0d;
            text-decoration: none;
        }

    /* ===== Features ===== */
    .features-section {
        padding: 40px 20px 60px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
    }

    .feature-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 32px 26px;
        text-align: center;
        transition: all 0.3s ease;
    }

        .feature-card:hover {
            border-color: #d4af37;
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(212, 175, 55, 0.12);
        }

    .feature-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border: 2px solid #d4af37;
        border-radius: 50%;
        background-color: #0d0d0d;
    }

    .feature-card h3 {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        margin: 0 0 12px 0;
    }

    .feature-card p {
        color: #888;
        font-size: 14px;
        line-height: 1.6;
        margin: 0;
    }

    /* ===== Tagline ===== */
    .tagline-section {
        text-align: center;
        padding: 30px 20px 50px;
        border-top: 1px solid #222;
    }

    .tagline {
        color: #d4af37;
        font-size: 14px;
        letter-spacing: 4px;
        text-transform: uppercase;
        font-style: italic;
        margin: 0;
    }

    @@media (max-width: 600px) {
        .hero-section h1 {
            font-size: 32px;
            letter-spacing: 2px;
        }

        .hero-logo {
            width: 100px;
            height: 100px;
        }
    }
</style>