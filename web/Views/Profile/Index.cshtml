@model CuttingEdge.ManagerPortal.Models.Profile

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<div class="page-header">
    <h1>My Profile</h1>
    <p class="subtitle">Account Details — View and update your personal information and password.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="profile-grid">

    <!-- ===== Left Column: Personal Information ===== -->
    <div class="profile-card">
        <div class="card-header">
            <h2>Personal Information</h2>
            <p class="card-subtitle">Keep your profile information up to date.</p>
        </div>

        <form asp-action="Update" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Role" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="profile-photo-section">
                <div class="photo-wrapper">
                    @if (!string.IsNullOrEmpty(Model?.Email))
                    {
                        <div class="avatar-circle">
                            @(Model?.FullName?.Substring(0, 1)?.ToUpper() ?? "M")
                        </div>
                    }
                    else
                    {
                        <div class="avatar-circle">M</div>
                    }
                </div>
                <div class="photo-info">
                    <label class="photo-label">Profile Photo</label>
                    <span class="photo-hint">JPG or PNG, max 2MB</span>
                </div>
            </div>

            <div class="form-group">
                <label>Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" required />
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required />
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input asp-for="Phone" type="tel" class="form-control" placeholder="Enter your phone number" />
            </div>

            <div class="form-group">
                <label>Branch / Location</label>
                <select class="form-control">
                    <option>Cutting Edge — Welkom Central</option>
                    <option>Cutting Edge — Bloemfontein CBD</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                💾 Save Changes
            </button>
        </form>
    </div>

    <!-- ===== Right Column: Security Settings ===== -->
    <div class="profile-card">
        <div class="card-header">
            <h2>Security Settings</h2>
            <p class="card-subtitle">Leave blank if you don't want to change your password.</p>
        </div>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Current Password</label>
                <div class="password-wrapper">
                    <input type="password" name="currentPassword" id="currentPassword" class="form-control" placeholder="Enter your current password" />
                    <button type="button" class="toggle-password" onclick="togglePassword('currentPassword')">👁</button>
                </div>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <div class="password-wrapper">
                    <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Min 8 characters" minlength="8" />
                    <button type="button" class="toggle-password" onclick="togglePassword('newPassword')">👁</button>
                </div>
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                <div class="password-wrapper">
                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Re-enter new password" minlength="8" />
                    <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword')">👁</button>
                </div>
            </div>

            <div class="password-requirements">
                <h4>Password must contain:</h4>
                <ul>
                    <li><span class="check">✓</span> At least 8 characters</li>
                    <li><span class="check">✓</span> One uppercase letter</li>
                    <li><span class="check">✓</span> One number</li>
                    <li><span class="check">✓</span> One special character</li>
                </ul>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                🔒 Update Password
            </button>
        </form>
    </div>

</div>

<script>
    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        input.type = input.type === "password" ? "text" : "password";
    }
</script>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

        .page-header h1 {
            color: #d4af37;
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }

        .page-header .subtitle {
            color: #888;
            font-size: 14px;
            margin: 5px 0 0 0;
        }

    /* ===== Grid Layout ===== */
    .profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    @@media (max-width: 900px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Card ===== */
    .profile-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 30px;
    }

    .card-header {
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #2a2a2a;
    }

        .card-header h2 {
            color: #d4af37;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 6px 0;
            letter-spacing: 0.5px;
        }

    .card-subtitle {
        color: #888;
        font-size: 13px;
        margin: 0;
        line-height: 1.5;
    }

    /* ===== Profile Photo ===== */
    .profile-photo-section {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .avatar-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background-color: #0d0d0d;
        border: 2px solid #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d4af37;
        font-size: 26px;
        font-weight: 700;
    }

    .photo-info {
        display: flex;
        flex-direction: column;
    }

    .photo-label {
        color: #d4af37;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .photo-hint {
        color: #666;
        font-size: 12px;
    }

    /* ===== Form ===== */
    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

        .form-control::placeholder {
            color: #555;
        }

    /* ===== Password Wrapper ===== */
    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
        font-size: 16px;
        padding: 5px;
        transition: color 0.3s ease;
    }

        .toggle-password:hover {
            color: #d4af37;
        }

    /* ===== Password Requirements ===== */
    .password-requirements {
        background-color: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 8px;
        padding: 16px;
        margin: 20px 0;
    }

        .password-requirements h4 {
            color: #fff;
            font-size: 13px;
            margin: 0 0 12px 0;
            font-weight: 600;
        }

        .password-requirements ul {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .password-requirements li {
            color: #aaa;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .check {
        color: #28a745;
        font-weight: bold;
    }

    /* ===== Buttons ===== */
    .btn {
        display: inline-block;
        padding: 14px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-block {
        display: block;
        width: 100%;
        margin-top: 10px;
    }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 500;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>