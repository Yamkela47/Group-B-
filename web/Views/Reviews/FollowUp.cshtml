@model CuttingEdge.ManagerPortal.Models.Review

@{
    ViewData["Title"] = "Follow Up on Feedback";
    Layout = "_Layout";
}

<div class="page-header">
    <p class="breadcrumb">Dashboard → Reviews → Follow Up</p>
    <h1>Follow Up on Feedback</h1>
    <p class="subtitle">Resolve the customer's concern and let the stylist know what happened.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="followup-grid">

    <!-- Left: Feedback Details -->
    <div class="feedback-card">
        <div class="card-header">
            <h2>Feedback Details</h2>
            @if (Model.FollowUpRequired && !Model.Resolved)
            {
                <span class="status-badge needs-followup">NEEDS FOLLOW UP</span>
            }
            else if (Model.Resolved)
            {
                <span class="status-badge resolved">✓ RESOLVED</span>
            }
        </div>

        <div class="customer-info">
            <div class="avatar-circle">
                @(Model.Customer?.FullName?.Substring(0, 1)?.ToUpper() ?? "?")
            </div>
            <div class="customer-details">
                <div class="customer-name">@Model.Customer?.FullName</div>
                <div class="customer-rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="star @(i <= Model.Rating ? "filled" : "")">★</span>
                    }
                </div>
                <div class="customer-stylist">Stylist: @Model.Stylist?.Profile?.FullName</div>
            </div>
            <div class="feedback-time">@Model.CreatedAt.ToString("dd MMM, HH:mm")</div>
        </div>

        <div class="comment-box">
            <p>"@Model.Comment"</p>
        </div>

        <!-- Booking Details -->
        @if (Model.Booking != null)
        {
            <div class="booking-details">
                <h3>Booking Details</h3>

                <div class="detail-row">
                    <span class="detail-label">Service:</span>
                    <span class="detail-value">@Model.Booking.Service?.Name</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Price:</span>
                    <span class="detail-value">R @Model.Booking.Service?.Price.ToString("N2")</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Payment:</span>
                    <span class="detail-value">@Model.Booking.PaymentMethod?.MethodName</span>
                </div>
            </div>
        }
    </div>

    <!-- Right: Take Action -->
    <div class="action-card">
        <div class="card-header">
            <h2>Take Action</h2>
        </div>

        <!-- Step 1: Send Apology -->
        <div class="action-section">
            <h3>1. Send Apology to Customer</h3>

            <form asp-action="SendApology" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reviewId" value="@Model.ReviewId" />

                <div class="form-group">
                    <label>To</label>
                    <input type="email" name="email" class="form-control"
                           value="@Model.Customer?.Email" required />
                </div>

                <div class="form-group">
                    <label>Subject</label>
                    <input type="text" name="subject" class="form-control"
                           value="We're sorry about your recent visit" required />
                </div>

                <div class="form-group">
                    <label>Message</label>
                    <textarea name="message" class="form-control" rows="5" required>Hi @Model.Customer?.FullName, thank you for your feedback. We're sorry your appointment felt rushed — that's not the experience we aim for. We'd love to make it right on your next visit.</textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    Send Apology to Customer
                </button>
            </form>
        </div>

        <!-- Step 2: Send Report to Stylist -->
        <div class="action-section">
            <h3>2. Send Report to Stylist</h3>

            <form asp-action="SendReportToStylist" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reviewId" value="@Model.ReviewId" />

                <div class="form-group">
                    <label>To</label>
                    <input type="email" name="email" class="form-control"
                           value="@(Model.Stylist?.Profile?.Email)@(string.IsNullOrEmpty(Model.Stylist?.Profile?.Email) ? "stylist@cuttingedge.co.za" : "")" required />
                </div>

                <div class="form-group">
                    <label>Note to Stylist</label>
                    <textarea name="note" class="form-control" rows="4" required>Customer felt the appointment ran long and felt rushed near the end. Please review your pacing for similar bookings going forward.</textarea>
                </div>

                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" name="ccManager" value="true" checked />
                        <span>CC me on this report</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-outline btn-block">
                    Send Report to Stylist
                </button>
            </form>
        </div>

        <!-- Mark as Resolved -->
        @if (!Model.Resolved)
        {
            <div class="action-section resolve-section">
                <form asp-action="MarkResolved" asp-route-id="@Model.ReviewId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-block">
                        Mark as Resolved
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="resolved-notice">
                ✓ This review has been marked as resolved.
            </div>
        }
    </div>

</div>

<div class="page-footer">
    <a asp-action="Index" class="btn btn-secondary">← Back to All Reviews</a>
</div>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    /* ===== Grid ===== */
    .followup-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 22px;
        margin-bottom: 25px;
    }

    @@media (max-width: 1000px) {
        .followup-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Cards ===== */
    .feedback-card,
    .action-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 25px;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        padding-bottom: 15px;
        border-bottom: 1px solid #2a2a2a;
    }

        .card-header h2 {
            color: #d4af37;
            font-size: 17px;
            font-weight: 700;
            margin: 0;
            letter-spacing: 0.5px;
        }

    .status-badge {
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

        .status-badge.needs-followup {
            background-color: rgba(220, 53, 69, 0.15);
            color: #dc3545;
            border: 1px solid #dc3545;
        }

        .status-badge.resolved {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

    /* ===== Customer Info ===== */
    .customer-info {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        position: relative;
    }

    .avatar-circle {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background-color: #0d0d0d;
        border: 2px solid #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d4af37;
        font-size: 22px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .customer-details {
        flex: 1;
    }

    .customer-name {
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .customer-rating .star {
        color: #444;
        font-size: 13px;
    }

        .customer-rating .star.filled {
            color: #d4af37;
        }

    .customer-stylist {
        color: #888;
        font-size: 12px;
        margin-top: 4px;
    }

    .feedback-time {
        color: #666;
        font-size: 12px;
        align-self: flex-start;
    }

    /* ===== Comment Box ===== */
    .comment-box {
        background-color: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-left: 3px solid #d4af37;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 22px;
    }

        .comment-box p {
            color: #ddd;
            font-size: 14px;
            font-style: italic;
            line-height: 1.6;
            margin: 0;
        }

    /* ===== Booking Details ===== */
    .booking-details {
        border-top: 1px solid #2a2a2a;
        padding-top: 18px;
    }

        .booking-details h3 {
            color: #d4af37;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 14px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #222;
        font-size: 13px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #888;
    }

    .detail-value {
        color: #ddd;
        font-weight: 600;
    }

    /* ===== Action Sections ===== */
    .action-section {
        margin-bottom: 28px;
        padding-bottom: 25px;
        border-bottom: 1px solid #2a2a2a;
    }

        .action-section:last-child {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .action-section h3 {
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 16px 0;
        }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 11px 14px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

    textarea.form-control {
        resize: vertical;
        line-height: 1.5;
    }

    /* ===== Checkbox ===== */
    .checkbox-group {
        margin: 12px 0;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #ddd;
        font-size: 13px;
    }

        .checkbox-label input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #d4af37;
            cursor: pointer;
        }

    /* ===== Buttons ===== */
    .btn {
        padding: 12px 22px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        text-align: center;
        letter-spacing: 0.3px;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #d4af37;
        color: #d4af37;
    }

        .btn-outline:hover {
            background-color: #d4af37;
            color: #0d0d0d;
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    .btn-block {
        display: block;
        width: 100%;
    }

    .resolve-section {
        margin-top: 10px;
    }

    .resolved-notice {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        border-radius: 8px;
        padding: 14px 20px;
        color: #28a745;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
    }

    /* ===== Page Footer ===== */
    .page-footer {
        text-align: center;
        padding-top: 10px;
    }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>