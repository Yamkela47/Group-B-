@* ============================================================
   PROJECT: Cutting Edge Salon
   STUDENT DETAILS:
   ------------------------------------------------------------
   Name                  | Student Number
   ------------------------------------------------------------
   Goitse Kgwele         | 221050663
   Thabang Zitha         | 223007074
   Yamkela Mazamani      | 224007421
   Nyakallo Pali         | 223060226
   Bennet Linda          | 224004294
   ============================================================ *@

@model CuttingEdge.ManagerPortal.ViewModels.ReviewFollowUpViewModel
@{
    ViewData["Title"] = "Follow Up on Customer Review";
    Layout = "_Layout";
    var review = Model.Review;
    var followUp = Model.FollowUp;
    bool customerNotified = followUp.CustomerNotifiedAt.HasValue;
    bool previouslyEmailed = followUp.CustomerSentAt.HasValue;
    bool apologyHandled = customerNotified || previouslyEmailed;
    bool stylistNotified = followUp.StylistNotifiedAt.HasValue;
}

<div class="page-header">
    <p class="breadcrumb">Dashboard → Reviews → Follow Up</p>
    <p class="subtitle">Send a personal apology to the customer and a separate feedback report to the stylist through Flutter Notifications. No email is required.</p>
</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="followup-grid">
    <section class="followup-card">
        <h2>Customer Feedback</h2>
        <div class="review-head">
            <div class="avatar-circle">@(string.IsNullOrEmpty(review.Customer?.FullName) ? "?" : review.Customer.FullName[..1].ToUpperInvariant())</div>
            <div>
                <strong>@(review.Customer?.FullName ?? "Customer")</strong>
                <div class="muted">Stylist: @(review.Stylist?.Profile?.FullName ?? "Not assigned")</div>
                <div class="muted">@review.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
        </div>
        <div class="rating-line">Stylist rating: @review.Rating / 5 <span class="gold">★</span></div>
        @if (review.ServiceRating.HasValue)
        {
            <div class="rating-line">Service rating: @review.ServiceRating / 5 <span class="gold">★</span></div>
        }
        <div class="review-comment">@(string.IsNullOrWhiteSpace(review.Comment) ? "No written comment provided." : review.Comment)</div>
        @if (review.Booking != null)
        {
            <div class="booking-details">
                <h3>Appointment</h3>
                <p><b>Service:</b> @(review.Booking.Service?.Name ?? "—")</p>
                <p><b>Date:</b> @review.Booking.AppointmentDate.ToString("dd MMM yyyy")</p>
                <p><b>Payment:</b> @(review.Booking.PaymentMethod?.MethodName ?? "—")</p>
            </div>
        }
        @if (review.Resolved)
        {
            <p class="status-ok">✓ Follow-up resolved</p>
        }
    </section>

    <section class="followup-card">
        <h2>Manager Follow Up</h2>
        <p class="muted">Both notifications go to the people linked to this review in Supabase. Customer and stylist messages are sent separately; no email is required.</p>
        <form asp-controller="Reviews" asp-action="SendApologyNotification" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reviewId" value="@review.ReviewId" />
            <div class="message-section">
                <div class="section-title">Apology Notification to Customer</div>
                @if (customerNotified)
                {
                    <p class="status-ok">✓ Sent to customer's Flutter Notifications inbox on @(followUp.CustomerNotifiedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</p>
                    <div class="sent-preview"><b>Title:</b> @followUp.ApologySubject<p>@followUp.ApologyMessage</p></div>
                }
                else if (previouslyEmailed)
                {
                    <p class="status-ok">✓ An apology was already emailed on @(followUp.CustomerSentAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")); no duplicate is needed.</p>
                    <div class="sent-preview"><b>Subject:</b> @followUp.ApologySubject<p>@followUp.ApologyMessage</p></div>
                }
                else
                {
                    <label>Customer</label>
                    <input class="form-control" readonly value="@(review.Customer?.FullName ?? "Customer")" />
                    <label for="apologySubject">Notification title</label>
                    <input class="form-control" id="apologySubject" name="apologySubject" maxlength="180" value="An apology from Cutting Edge Salon" required />
                    <label for="apologyMessage">Your apology message</label>
                    <textarea class="form-control" id="apologyMessage" name="apologyMessage" rows="6" maxlength="5000" placeholder="Write a personal apology based on the customer's feedback..." required></textarea>
                }
            </div>
            @if (!review.Resolved && !apologyHandled)
            {
                <button type="submit" class="btn btn-primary">Send Apology Notification</button>
            }
        </form>
        <div class="report-section">
            <h3 class="section-title">Feedback Report to Stylist</h3>
            <p class="muted">This report goes to @(review.Stylist?.Profile?.FullName ?? "the assigned stylist") in their Flutter Notifications inbox.</p>
            @if (stylistNotified)
            {
                <p class="status-ok">✓ Sent to stylist's Flutter Notifications inbox on @(followUp.StylistNotifiedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</p>
                <div class="sent-preview"><b>Title:</b> @followUp.StylistReportTitle<p>@followUp.StylistReport</p></div>
            }
            else
            {
                <form asp-controller="Reviews" asp-action="SendStylistReportNotification" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reviewId" value="@review.ReviewId" />
                    <label>Stylist</label>
                    <input class="form-control" readonly value="@(review.Stylist?.Profile?.FullName ?? "Stylist")" />
                    <label for="stylistReportTitle">Notification title</label>
                    <input class="form-control" id="stylistReportTitle" name="stylistReportTitle" maxlength="180" value="Customer Review Feedback - Cutting Edge Salon" required />
                    <label for="stylistReportMessage">Your feedback report to the stylist</label>
                    <textarea class="form-control" id="stylistReportMessage" name="stylistReportMessage" rows="6" maxlength="5000" placeholder="Describe the customer’s complaint and the improvements you expect from the stylist..." required></textarea>
                    <button type="submit" class="btn btn-primary report-button">Send Report Notification to Stylist</button>
                </form>
            }
        </div>
        @if (!review.Resolved && apologyHandled && stylistNotified)
        {
            <form asp-controller="Reviews" asp-action="MarkResolved" asp-route-id="@review.ReviewId" method="post" class="resolve-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Mark Follow Up as Resolved</button>
            </form>
        }
        else if (!review.Resolved)
        {
            <p class="muted">Send both the customer apology and stylist report to enable Mark Follow Up as Resolved.</p>
        }
        @if (review.Resolved)
        {
            <div class="status-ok">This review has been marked resolved. You can still send a missing stylist report above.</div>
        }
    </section>
</div>
<a asp-controller="Reviews" asp-action="Index" class="btn btn-secondary">← Back to All Reviews</a>

<style>
    .page-header {
        margin-bottom: 25px
    }

    .breadcrumb, .muted {
        color: #999;
        font-size: 13px
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        margin: 5px 0
    }

    .page-header .subtitle {
        color: #999;
        font-size: 14px
    }

    .followup-grid {
        display: grid;
        grid-template-columns: 1fr 1.25fr;
        gap: 22px;
        margin-bottom: 26px
    }

    @@media(max-width:980px) {
        .followup-grid {
            grid-template-columns: 1fr
        }
    }

    .followup-card {
        padding: 26px;
        border-radius: 14px;
        background: #1a1a1a;
        border: 1px solid #383838
    }

        .followup-card h2 {
            margin: 0 0 20px;
            color: #d4af37;
            font-size: 18px
        }

    .review-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 20px;
        border-bottom: 1px solid #333
    }

    .avatar-circle {
        display: grid;
        place-items: center;
        border: 2px solid #d4af37;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        flex-shrink: 0;
        color: #d4af37;
        font-weight: 700
    }

    .rating-line {
        color: #eee;
        margin-top: 14px
    }

    .gold {
        color: #d4af37
    }

    .review-comment {
        background: #111;
        padding: 18px;
        border-left: 3px solid #d4af37;
        border-radius: 6px;
        margin: 22px 0;
        white-space: pre-line;
        color: #eee
    }

    .booking-details {
        border-top: 1px solid #333;
        padding-top: 14px
    }

        .booking-details h3 {
            font-size: 15px;
            color: #d4af37
        }

        .booking-details p {
            font-size: 14px;
            color: #ccc
        }

    .message-section {
        padding: 18px 0;
        border-top: 1px solid #333
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #d4af37;
        margin-bottom: 18px
    }

    .message-section label,
    .report-section label {
        display: block;
        margin: 14px 0 7px;
        color: #d4af37;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700
    }

    .form-control {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        color: #fff;
        background: #0d0d0d;
        border: 1px solid #555;
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit
    }

        .form-control:focus {
            outline: none;
            border-color: #d4af37
        }

        .form-control[readonly] {
            opacity: .75
        }

    .status-ok {
        color: #32cc72;
        font-size: 13px;
        line-height: 1.5
    }

    .sent-preview {
        background: #101010;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 14px;
        white-space: pre-wrap;
        color: #ddd;
        overflow-wrap: anywhere
    }

    .btn {
        display: inline-block;
        text-decoration: none;
        font-weight: 700;
        padding: 12px 20px;
        border-radius: 8px;
        border: 0;
        cursor: pointer;
        font-size: 14px
    }

    .btn-primary {
        color: #111;
        background: #d4af37
    }

    .btn-secondary {
        color: #fff;
        background: #333
    }

    .resolve-form {
        margin-top: 18px
    }

    .report-section {
        padding-top: 20px;
        margin-top: 22px;
        border-top: 1px solid #383838;
    }

    .report-button {
        margin-top: 18px;
    }

    .alert {
        padding: 14px 20px;
        border-radius: 9px;
        margin-bottom: 16px
    }

    .alert-danger {
        background: #351417;
        color: #ff858e;
        border: 1px solid #dc3545
    }

    .alert-success {
        background: #10281a;
        color: #32cc72;
        border: 1px solid #238e46
    }
</style>
