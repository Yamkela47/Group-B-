@model CuttingEdge.ManagerPortal.Models.Service

@{
    ViewData["Title"] = "New Service";
    Layout = "_Layout";

    var stylists = ViewBag.Stylists as List<CuttingEdge.ManagerPortal.Models.Stylist>;
}

<div class="page-header">
    <p class="breadcrumb">Services & Promotions > New Service</p>
    <h1>New Service</h1>
    <p class="subtitle">Add a new service to your salon. Keep the information clear and accurate.</p>
</div>

<div class="form-container">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <!-- Service Details -->
        <div class="form-section">
            <h2>Service Details</h2>

            <div class="form-row">
                <div class="form-group">
                    <label>Service Name <span class="required">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Beard Sculpt & Line-Up" required />
                </div>

                <div class="form-group">
                    <label>Category <span class="required">*</span></label>
                    <select class="form-control" required>
                        <option value="">Select category</option>
                        <option value="Hair Cut & Coloring">Hair Cut & Coloring</option>
                        <option value="Grooming">Grooming</option>
                        <option value="Treatment">Treatment</option>
                        <option value="Facial">Facial</option>
                        <option value="Styling">Styling</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Price (R) <span class="required">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="90.00" required />
                </div>

                <div class="form-group">
                    <label>Duration <span class="required">*</span></label>
                    <input asp-for="DurationMinutes" type="number" min="1" class="form-control" placeholder="30 minutes" required />
                </div>
            </div>

            <div class="form-group">
                <label>Assign Stylist(s) <span class="required">*</span></label>
                <p class="field-hint">Select which stylists are able to perform this service.</p>

                <div class="stylist-chips">
                    @if (stylists != null && stylists.Any())
                    {
                        @foreach (var stylist in stylists)
                        {
                            <label class="chip-label">
                                <input type="checkbox" name="StylistIds" value="@stylist.StylistId" />
                                <span class="chip">@stylist.Profile?.FullName</span>
                            </label>
                        }
                    }
                    <button type="button" class="chip-select-all" onclick="selectAllStylists()">+ Select all</button>
                </div>
            </div>

            <div class="form-group">
                <label>Description <span class="required">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Describe the service in a way that is clear and helpful for customers..."></textarea>
            </div>
        </div>

        <!-- Image & Status -->
        <div class="form-section">
            <h2>Image & Status</h2>

            <div class="form-group">
                <label>Service Image (Optional)</label>
                <div class="upload-box">
                    <span class="upload-icon">☁</span>
                    <p class="upload-text">Click to upload image</p>
                    <p class="upload-hint">PNG, JPG (Max 5MB)</p>
                    <input type="file" name="imageFile" accept="image/png,image/jpeg" class="file-input" />
                </div>
            </div>

            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="Active" type="checkbox" checked />
                    <span class="checkbox-text">
                        <strong>Set as Active</strong>
                        <span class="hint">Active services will be visible to customers and can be booked.</span>
                    </span>
                </label>
            </div>

            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="IsFlagship" type="checkbox" />
                    <span class="checkbox-text">
                        <strong>Mark as Flagship Service</strong>
                        <span class="hint">Flagship services are promoted on the customer home screen.</span>
                    </span>
                </label>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Service</button>
        </div>
    </form>
</div>

<script>
    function selectAllStylists() {
        document.querySelectorAll('input[name="StylistIds"]').forEach(cb => cb.checked = true);
    }
</script>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    .form-container {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 35px;
        max-width: 900px;
    }

    .form-section {
        margin-bottom: 30px;
        padding-bottom: 25px;
        border-bottom: 1px solid #2a2a2a;
    }

        .form-section:last-of-type {
            border-bottom: none;
            padding-bottom: 0;
        }

        .form-section h2 {
            color: #d4af37;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 20px 0;
            letter-spacing: 0.5px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .required {
        color: #dc3545;
    }

    .field-hint {
        color: #888;
        font-size: 12px;
        margin: 0 0 12px 0;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

        .form-control::placeholder {
            color: #555;
        }

    textarea.form-control {
        resize: vertical;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Stylist Chips ===== */
    .stylist-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .chip-label {
        cursor: pointer;
    }

        .chip-label input {
            display: none;
        }

    .chip {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 24px;
        background-color: #0d0d0d;
        border: 1px solid #444;
        color: #aaa;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .chip-label input:checked + .chip {
        background-color: #d4af37;
        border-color: #d4af37;
        color: #0d0d0d;
    }

    .chip-label:hover .chip {
        border-color: #d4af37;
        color: #d4af37;
    }

    .chip-label input:checked:hover + .chip {
        color: #0d0d0d;
    }

    .chip-select-all {
        padding: 8px 18px;
        border-radius: 24px;
        background-color: transparent;
        border: 1px dashed #d4af37;
        color: #d4af37;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .chip-select-all:hover {
            background-color: rgba(212, 175, 55, 0.1);
        }

    /* ===== Upload Box ===== */
    .upload-box {
        border: 2px dashed #444;
        border-radius: 10px;
        padding: 30px;
        text-align: center;
        background-color: #0d0d0d;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

        .upload-box:hover {
            border-color: #d4af37;
        }

    .upload-icon {
        font-size: 32px;
        display: block;
        margin-bottom: 10px;
    }

    .upload-text {
        color: #ddd;
        font-size: 14px;
        margin: 0;
        font-weight: 600;
    }

    .upload-hint {
        color: #666;
        font-size: 12px;
        margin: 4px 0 0 0;
    }

    .file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    /* ===== Checkbox ===== */
    .checkbox-group {
        margin-top: 15px;
    }

    .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        cursor: pointer;
    }

        .checkbox-label input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-top: 2px;
            accent-color: #d4af37;
            cursor: pointer;
        }

    .checkbox-text {
        display: flex;
        flex-direction: column;
    }

        .checkbox-text strong {
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .checkbox-text .hint {
            color: #888;
            font-size: 12px;
        }

    /* ===== Form Actions ===== */
    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .btn {
        padding: 12px 26px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>