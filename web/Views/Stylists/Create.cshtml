            height: 18px;
            width: 18px;
            left: 3px;
            top: 3px;
            background-color: #fff;
            border-radius: 50%;
            transition: all 0.25s ease;
        }

    .switch input:checked + input + .slider {
        background-color: #d4af37;
    }

        .switch input:checked + input + .slider::before {
            transform: translateX(20px);
            background-color: #111;
        }

