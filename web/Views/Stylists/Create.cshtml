@model CuttingEdge.ManagerPortal.ViewModels.StylistViewModel

@{
    ViewData["Title"] = "New Stylist";
    Layout = "_Layout";

    var services = ViewBag.Services as List<CuttingEdge.ManagerPortal.Models.Service>;
}

<div class="page-header">
    <p class="breadcrumb">Stylists > New Stylist</p>
    <p class="subtitle">Add a new stylist to the team.</p>
</div>

<div class="form-container">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <!-- Photo -->
        <div class="photo-section">
            <div class="photo-avatar" id="photoAvatar">
                <span>+</span>
            </div>
            <div class="photo-info">
                <label class="photo-label">Profile Photo</label>
                <label class="btn-upload">
                    Upload Photo
                    <input type="file" name="photoFile" accept="image/png,image/jpeg" onchange="previewPhoto(event)" />
                </label>
            </div>
        </div>

        <!-- Personal Info -->
        <div class="form-section">
            <h2>Personal Information</h2>

            <div class="form-group">
                <label>Full Name <span class="required">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="e.g., Thabang" required />
            </div>

            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="stylist@cuttingedge.co.za" required />
            </div>

            <div class="form-group">
                <label asp-for="InitialPassword">Login Password (Optional - auto-generated if blank)</label>
                <input asp-for="InitialPassword" type="password" class="form-control" minlength="8"
                       autocomplete="new-password" placeholder="At least 8 characters" />
                <span asp-validation-for="InitialPassword" class="text-danger"></span>
                <p class="field-hint">Leave blank and the system generates a secure password. Either way, the stylist is emailed their login email and password and should change it after their first login.</p>
            </div>

            <div class="form-group">
                <label asp-for="Phone">Contact Number <span class="required">*</span></label>
                <input asp-for="Phone" type="tel" class="form-control" placeholder="075 665 8912"
                       inputmode="tel" maxlength="15" required
                       pattern="^\+?[0-9\s]{10,15}$"
                       title="Enter a valid phone number using digits only (10 to 15 digits), e.g. 075 665 8912"
                       oninput="this.value = this.value.replace(/[^0-9+\s]/g, '')" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
        </div>

        <!-- Services -->
        <div class="form-section">
            <h2>Services Offered</h2>
            <p class="field-hint">Select the services this stylist can perform.</p>

            <div class="stylist-chips">
                @if (services != null && services.Any())
                {
                    @foreach (var service in services)
                    {
                        <label class="chip-label">
                            <input type="checkbox" name="ServiceIds" value="@service.ServiceId" />
                            <span class="chip">@service.Name</span>
                        </label>
                    }
                }
                else
                {
                    <p class="hint">No services available yet.</p>
                }
                <button type="button" class="chip-select-all" onclick="selectAllServices()">+ Select all</button>
            </div>
        </div>

        <!-- Working Days & Hours -->
        <div class="form-section">
            <h2>Working Days &amp; Hours</h2>
            <p class="field-hint">Switch on the days this stylist works, then choose their start and end time for each day.</p>

            <div class="week-toolbar">
                <button type="button" class="btn-mini" onclick="copyMondayToAll()">Copy Monday's hours to all open days</button>
                <span class="week-summary" id="weekSummary"></span>
            </div>

            <div class="week-grid" id="weekGrid">
                @{
                    var weekDays = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                    var posted = Model?.WeekSchedule;
                }
                @foreach (var day in weekDays)
                {
                    var hasPosted = posted != null && posted.TryGetValue(day, out _);
                    var enabled = hasPosted ? posted![day].Enabled : day != "Sunday";
                    var startValue = hasPosted && !string.IsNullOrEmpty(posted![day].StartTime) ? posted[day].StartTime : "09:00";
                    var endValue = hasPosted && !string.IsNullOrEmpty(posted![day].EndTime) ? posted[day].EndTime : (day == "Saturday" ? "15:00" : "17:00");

                    <div class="day-row @(enabled ? "" : "is-off")">
                        <label class="switch" title="Works on @day">
                            <input type="checkbox" class="day-toggle" name="WeekSchedule[@day].Enabled" value="true" checked="@enabled" />
                            <input type="hidden" name="WeekSchedule[@day].Enabled" value="false" />
                            <span class="slider"></span>
                        </label>
                        <span class="day-name">@day</span>
                        <div class="day-times">
                            <input type="time" name="WeekSchedule[@day].StartTime" class="form-control time-input" value="@startValue" readonly="@(!enabled)" />
                            <span class="to-sep">to</span>
                            <input type="time" name="WeekSchedule[@day].EndTime" class="form-control time-input" value="@endValue" readonly="@(!enabled)" />
                        </div>
                        <span class="day-off-label">Day off</span>
                        <span class="day-error">End must be after start</span>
                    </div>
                }
            </div>

            <p class="field-hint week-note">The schedule is created for the next 8 weeks from today. You can change it any time under <strong>Schedule</strong>.</p>
        </div>

        <!-- Status -->
        <div class="form-section">
            <h2>Status</h2>

            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="Active" type="checkbox" checked />
                    <span class="checkbox-text">
                        <strong>Active</strong>
                        <span class="hint">Active stylists are visible to customers when booking.</span>
                    </span>
                </label>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Add Stylist</button>
        </div>
    </form>
</div>

<script>
    function selectAllServices() {
        document.querySelectorAll('input[name="ServiceIds"]').forEach(cb => cb.checked = true);
    }

    function previewPhoto(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (e) {
            const avatar = document.getElementById('photoAvatar');
            avatar.style.backgroundImage = `url(${e.target.result})`;
            avatar.classList.add('has-image');
            avatar.innerHTML = '';
        };
        reader.readAsDataURL(file);
    }

    // ===== Weekly hours editor =====
    function toMinutes(v) {
        if (!v) return NaN;
        const parts = v.split(':').map(Number);
        return parts[0] * 60 + parts[1];
    }

    function refreshWeek() {
        let openDays = 0, totalMinutes = 0;
        document.querySelectorAll('#weekGrid .day-row').forEach(row => {
            const on = row.querySelector('.day-toggle').checked;
            const times = row.querySelectorAll('.time-input');
            const diff = toMinutes(times[1].value) - toMinutes(times[0].value);
            row.classList.toggle('is-off', !on);
            times.forEach(t => t.readOnly = !on);
            row.classList.toggle('is-invalid', on && !(diff > 0));
            if (on) openDays++;
            if (on && diff > 0) totalMinutes += diff;
        });
        const hours = Math.round(totalMinutes / 6) / 10;
        document.getElementById('weekSummary').textContent =
            openDays === 0 ? 'No working days selected'
                           : openDays + (openDays === 1 ? ' working day' : ' working days') + ' \u00B7 ' + hours + ' hours per week';
    }

    function copyMondayToAll() {
        const rows = document.querySelectorAll('#weekGrid .day-row');
        const monday = rows[0].querySelectorAll('.time-input');
        rows.forEach((row, i) => {
            if (i === 0 || !row.querySelector('.day-toggle').checked) return;
            const t = row.querySelectorAll('.time-input');
            t[0].value = monday[0].value;
            t[1].value = monday[1].value;
        });
        refreshWeek();
    }

    document.querySelectorAll('#weekGrid .day-toggle, #weekGrid .time-input').forEach(el => {
        el.addEventListener('input', refreshWeek);
        el.addEventListener('change', refreshWeek);
    });

    document.getElementById('weekGrid').closest('form').addEventListener('submit', function (e) {
        refreshWeek();
        const bad = document.querySelector('#weekGrid .day-row.is-invalid');
        if (bad) {
            e.preventDefault();
            bad.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    refreshWeek();
</script>

<style>
