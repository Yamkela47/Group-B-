        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        margin: 0;
        cursor: pointer;
    }

        .switch input[type="checkbox"] {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

    .slider {
        position: absolute;
        inset: 0;
        background-color: #333;
        border-radius: 24px;
        transition: all 0.25s ease;
    }

        .slider::before {
            content: "";
