@model List<CuttingEdge.ManagerPortal.Models.Stylist>

@{
    ViewData["Title"] = "Stylists";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h1>Stylists</h1>
        <p class="subtitle">Stylist Management</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Stylist</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Filters -->
<div class="filters-row">
    <div class="filter-group">
        <label>Search</label>
        <input type="text" id="searchInput" class="form-control" placeholder="Search stylist..." onkeyup="filterStylists()" />
    </div>
    <div class="filter-group">
        <label>Status</label>
        <select id="statusFilter" class="form-control" onchange="filterStylists()">
            <option value="">All</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>
</div>

<!-- Stylists Grid -->
@if (Model != null && Model.Any())
{
    <div class="stylists-grid" id="stylistsGrid">
        @foreach (var stylist in Model)
        {
            <div class="stylist-card @(stylist.Active ? "" : "inactive")"
                 data-stylist-name="@stylist.Profile?.FullName"
                 data-stylist-status="@(stylist.Active ? "active" : "inactive")">

                <div class="stylist-photo-wrapper">
                    @if (!string.IsNullOrEmpty(stylist.PhotoUrl))
                    {
                        <img src="@stylist.PhotoUrl" alt="@stylist.Profile?.FullName" class="stylist-photo" />
                    }
                    else
                    {
                        <div class="stylist-photo placeholder">
                            @(stylist.Profile?.FullName?.Substring(0, 1)?.ToUpper() ?? "?")
                        </div>
                    }

                    <span class="status-dot @(stylist.Active ? "online" : "offline")"></span>
                </div>

                <div class="stylist-info">
                    <h3>@stylist.Profile?.FullName</h3>

                    <div class="stylist-meta">
                        <span class="meta-item">
                            <span class="meta-label">Email:</span>
                            <span class="meta-value">@stylist.Profile?.Email</span>
                        </span>
                        <span class="meta-item">
                            <span class="meta-label">Role:</span>
                            <span class="meta-value">
                                @if (stylist.Profile?.Role == "Manager")
                                {
                                    <text>Manager / Receptionist</text>
                                }
                                else
                                {
                                    <text>Stylist — All Services</text>
                                }
                            </span>
                        </span>
                        <span class="meta-item">
                            <span class="meta-label">Status:</span>
                            <span class="status-badge @(stylist.Active ? "active" : "inactive")">
                                @(stylist.Active ? "Active" : "Deactivated")
                            </span>
                        </span>
                    </div>

                    <div class="stylist-actions">
                        <a asp-action="Details" asp-route-id="@stylist.StylistId" class="btn btn-outline btn-sm">View</a>
                        <a asp-action="Edit" asp-route-id="@stylist.StylistId" class="btn btn-outline btn-sm">Edit</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="noResults" class="empty-state" style="display:none;">
        <p>No stylists match your filters.</p>
    </div>
}
else
{
    <div class="empty-state">
        <p>No stylists found. Click "+ Add Stylist" to add one.</p>
    </div>
}

<script>
    function filterStylists() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const status = document.getElementById('statusFilter').value;
        const cards = document.querySelectorAll('.stylist-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const name = (card.getAttribute('data-stylist-name') || '').toLowerCase();
            const cardStatus = card.getAttribute('data-stylist-status');

            const matchesSearch = !search || name.includes(search);
            const matchesStatus = !status || cardStatus === status;

            if (matchesSearch && matchesStatus) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        const noResults = document.getElementById('noResults');
        if (noResults) {
            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    }
</script>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .page-header h1 {
            color: #d4af37;
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }

        .page-header .subtitle {
            color: #888;
            font-size: 14px;
            margin: 5px 0 0 0;
        }

    /* ===== Filters ===== */
    .filters-row {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

        .filter-group label {
            display: block;
            color: #d4af37;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

    /* ===== Stylists Grid ===== */
    .stylists-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 20px;
    }

    .stylist-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        gap: 18px;
        transition: all 0.3s ease;
        position: relative;
    }

        .stylist-card:hover {
            border-color: #d4af37;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.1);
        }

        .stylist-card.inactive {
            opacity: 0.6;
        }

    /* ===== Photo ===== */
    .stylist-photo-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .stylist-photo {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #d4af37;
        display: block;
    }

        .stylist-photo.placeholder {
            background-color: #0d0d0d;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d4af37;
            font-size: 30px;
            font-weight: 700;
        }

    .status-dot {
        position: absolute;
        bottom: 4px;
        right: 4px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 3px solid #1a1a1a;
    }

        .status-dot.online {
            background-color: #28a745;
        }

        .status-dot.offline {
            background-color: #666;
        }

    /* ===== Info ===== */
    .stylist-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

        .stylist-info h3 {
            color: #fff;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 12px 0;
            line-height: 1.3;
        }

    .stylist-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 14px;
        flex: 1;
    }

    .meta-item {
        display: flex;
        gap: 8px;
        font-size: 12px;
        align-items: center;
    }

    .meta-label {
        color: #777;
        font-weight: 500;
        min-width: 45px;
    }

    .meta-value {
        color: #ddd;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .status-badge {
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .status-badge.active {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .status-badge.inactive {
            background-color: rgba(108, 117, 125, 0.15);
            color: #888;
            border: 1px solid #555;
        }

    .stylist-actions {
        display: flex;
        gap: 8px;
    }

    /* ===== Buttons ===== */
    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        text-align: center;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            color: #0d0d0d;
            transform: translateY(-1px);
        }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #d4af37;
        color: #d4af37;
        flex: 1;
    }

        .btn-outline:hover {
            background-color: #d4af37;
            color: #0d0d0d;
        }

    .btn-sm {
        padding: 7px 14px;
        font-size: 12px;
    }

    /* ===== Empty State ===== */
    .empty-state {
        background-color: #1a1a1a;
        border: 1px dashed #444;
        border-radius: 12px;
        padding: 60px 20px;
        text-align: center;
    }

        .empty-state p {
            color: #888;
            font-size: 14px;
            margin: 0;
        }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>