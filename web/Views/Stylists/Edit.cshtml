@model CuttingEdge.ManagerPortal.ViewModels.StylistViewModel

@{
    ViewData["Title"] = "Edit Stylist";
    Layout = "_Layout";

    var services = ViewBag.Services as List<CuttingEdge.ManagerPortal.Models.Service>;
}

<div class="page-header">
    <p class="breadcrumb">Stylists > Edit Stylist</p>
    <h1>Edit Stylist</h1>
    <p class="subtitle">Update the stylist's information below.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="form-container">
    <form asp-action="Edit" asp-route-id="@Model.StylistId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StylistId" />
        <input type="hidden" asp-for="PhotoUrl" />

        <div class="edit-header">
            <h2>@Model.FullName</h2>
            <span class="status-pill @(Model.Active ? "active" : "inactive")">
                ● @(Model.Active ? "Active" : "Deactivated")
            </span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <!-- Photo -->
        <div class="photo-section">
            <div class="photo-avatar" id="photoAvatar"
                 style="@(!string.IsNullOrEmpty(Model.PhotoUrl) ? $"background-image: url('{Model.PhotoUrl}');" : "")">
                @if (string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <span>@(Model.FullName?.Substring(0, 1)?.ToUpper() ?? "?")</span>
                }
            </div>
            <div class="photo-info">
                <label class="photo-label">Profile Photo</label>
                <label class="btn-upload">
                    Change Photo
                    <input type="file" name="photoFile" accept="image/png,image/jpeg" onchange="previewPhoto(event)" />
                </label>
            </div>
        </div>

        <!-- Personal Info -->
        <div class="form-section">
            <h2>Personal Information</h2>

            <div class="form-row">
                <div class="form-group">
                    <label>Full Name <span class="required">*</span></label>
                    <input asp-for="FullName" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Contact Number <span class="required">*</span></label>
                    <input asp-for="Phone" type="tel" class="form-control" required />
                </div>
            </div>

            <div class="form-group">
                <label>Email <span class="required">*</span></label>
                <input asp-for="Email" type="email" class="form-control" required />
            </div>
        </div>

        <!-- Services -->
        <div class="form-section">
            <h2>Services Offered</h2>

            <div class="stylist-chips">
                @if (services != null)
                {
                    @foreach (var service in services)
                    {
                        var isSelected = Model.ServiceIds != null && Model.ServiceIds.Contains(service.ServiceId);
                        <label class="chip-label">
                            <input type="checkbox" name="ServiceIds" value="@service.ServiceId" checked="@isSelected" />
                            <span class="chip">@service.Name</span>
                        </label>
                    }
                }
                <button type="button" class="chip-select-all" onclick="selectAllServices()">+ Select all</button>
            </div>
        </div>

        <!-- Working Hours & Role -->
        <div class="form-section">
            <h2>Working Hours & Role</h2>

            <div class="form-row">
                <div class="form-group">
                    <label>Working Hours</label>
                    <input asp-for="WorkingHours" class="form-control" placeholder="Mon–Sat, 09:00 – 17:00" />
                </div>

                <div class="form-group">
                    <label>Role <span class="required">*</span></label>
                    <div class="role-toggle">
                        <label class="role-option">
                            <input type="radio" name="Role" value="Stylist" checked="@(Model.Role == "Stylist")" />
                            <span class="role-pill">Stylist</span>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="Role" value="Manager" checked="@(Model.Role == "Manager")" />
                            <span class="role-pill">Manager</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status -->
        <div class="form-section">
            <h2>Status</h2>
            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="Active" type="checkbox" />
                    <span class="checkbox-text">
                        <strong>Active</strong>
                        <span class="hint">Active stylists are visible to customers when booking.</span>
                    </span>
                </label>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <button type="submit" form="deactivateForm" class="btn btn-secondary">Deactivate Stylist</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>

    <!-- Deactivate form (submitted by the button above) -->
    <form id="deactivateForm" asp-action="Deactivate" asp-route-id="@Model.StylistId" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
</div>

<script>
    function selectAllServices() {
        document.querySelectorAll('input[name="ServiceIds"]').forEach(cb => cb.checked = true);
    }

    function previewPhoto(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (e) {
            const avatar = document.getElementById('photoAvatar');
            avatar.style.backgroundImage = `url(${e.target.result})`;
            avatar.innerHTML = '';
        };
        reader.readAsDataURL(file);
    }
</script>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    .form-container {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 35px;
        max-width: 800px;
    }

    .edit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 18px;
        border-bottom: 1px solid #2a2a2a;
    }

        .edit-header h2 {
            color: #fff;
            font-size: 20px;
            font-weight: 700;
            margin: 0;
        }

    .status-pill {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

        .status-pill.active {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .status-pill.inactive {
            background-color: rgba(108, 117, 125, 0.15);
            color: #888;
            border: 1px solid #555;
        }

    /* ===== Photo ===== */
    .photo-section {
        display: flex;
        align-items: center;
        gap: 22px;
        margin-bottom: 28px;
        padding-bottom: 25px;
        border-bottom: 1px solid #2a2a2a;
    }

    .photo-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background-color: #0d0d0d;
        border: 2px solid #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d4af37;
        font-size: 34px;
        font-weight: 700;
        background-size: cover;
        background-position: center;
        flex-shrink: 0;
    }

    .photo-info {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .photo-label {
        color: #d4af37;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-upload {
        padding: 10px 20px;
        background-color: transparent;
        border: 1px solid #d4af37;
        color: #d4af37;
        font-size: 13px;
        font-weight: 700;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-block;
        text-align: center;
    }

        .btn-upload:hover {
            background-color: #d4af37;
            color: #0d0d0d;
        }

        .btn-upload input {
            display: none;
        }

    /* ===== Form Sections ===== */
    .form-section {
        margin-bottom: 28px;
        padding-bottom: 25px;
        border-bottom: 1px solid #2a2a2a;
    }

        .form-section:last-of-type {
            border-bottom: none;
            padding-bottom: 0;
        }

        .form-section h2 {
            color: #d4af37;
            font-size: 15px;
            font-weight: 700;
            margin: 0 0 18px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .required {
        color: #dc3545;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Service Chips ===== */
    .stylist-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .chip-label {
        cursor: pointer;
    }

        .chip-label input {
            display: none;
        }

    .chip {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 24px;
        background-color: #0d0d0d;
        border: 1px solid #444;
        color: #aaa;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .chip-label input:checked + .chip {
        background-color: #d4af37;
        border-color: #d4af37;
        color: #0d0d0d;
    }

    .chip-label:hover .chip {
        border-color: #d4af37;
        color: #d4af37;
    }

    .chip-label input:checked:hover + .chip {
        color: #0d0d0d;
    }

    .chip-select-all {
        padding: 8px 18px;
        border-radius: 24px;
        background-color: transparent;
        border: 1px dashed #d4af37;
        color: #d4af37;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .chip-select-all:hover {
            background-color: rgba(212, 175, 55, 0.1);
        }

    /* ===== Role Toggle ===== */
    .role-toggle {
        display: flex;
        gap: 10px;
    }

    .role-option {
        cursor: pointer;
        flex: 1;
    }

        .role-option input {
            display: none;
        }

    .role-pill {
        display: block;
        padding: 12px 20px;
        border-radius: 24px;
        background-color: #0d0d0d;
        border: 1px solid #444;
        color: #aaa;
        font-size: 14px;
        font-weight: 600;
        text-align: center;
        transition: all 0.3s ease;
    }

    .role-option input:checked + .role-pill {
        background-color: #d4af37;
        border-color: #d4af37;
        color: #0d0d0d;
    }

    .role-option:hover .role-pill {
        border-color: #d4af37;
        color: #d4af37;
    }

    .role-option input:checked:hover + .role-pill {
        color: #0d0d0d;
    }

    /* ===== Checkbox ===== */
    .checkbox-group {
        margin-top: 10px;
    }

    .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        cursor: pointer;
    }

        .checkbox-label input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-top: 2px;
            accent-color: #d4af37;
            cursor: pointer;
        }

    .checkbox-text {
        display: flex;
        flex-direction: column;
    }

        .checkbox-text strong {
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .checkbox-text .hint {
            color: #888;
            font-size: 12px;
        }

    /* ===== Form Actions ===== */
    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 25px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 22px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>