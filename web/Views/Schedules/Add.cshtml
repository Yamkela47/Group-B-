@model CuttingEdge.ManagerPortal.ViewModels.ScheduleViewModel

@{
    ViewData["Title"] = "Add Schedule";
    Layout = "_Layout";

    var stylists = ViewBag.Stylists as List<CuttingEdge.ManagerPortal.Models.Stylist>;
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
}

<div class="page-header">
    <p class="breadcrumb">Schedule > Add Schedule</p>
    <h1>Add Schedule</h1>
    <p class="subtitle">Set individual working hours for each day of the week.</p>
</div>

<div class="form-container">
    <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <!-- Stylist Selection -->
        <div class="form-group">
            <label>Stylist <span class="required">*</span></label>
            <select asp-for="StylistId" class="form-control" required>
                <option value="">Select stylist</option>
                @if (stylists != null)
                {
                    @foreach (var stylist in stylists)
                    {
                        <option value="@stylist.StylistId">@stylist.Profile?.FullName</option>
                    }
                }
            </select>
        </div>

        <!-- Day-by-day hours -->
        <div class="days-section">
            <h2>Set Hours for Each Day</h2>
            <p class="section-subtitle">Toggle a day on to set its own start and end time.</p>

            <div class="days-table">
                <div class="days-header">
                    <div class="col-day">Day</div>
                    <div class="col-status">Status</div>
                    <div class="col-time">Start Time</div>
                    <div class="col-time">End Time</div>
                </div>

                @foreach (var day in days)
                {
                    <div class="day-row">
                        <div class="col-day">
                            <span class="day-name">@day</span>
                        </div>

                        <div class="col-status">
                            <label class="toggle-switch">
                                <input type="checkbox" name="WeekSchedule[@day].Enabled" value="true" class="day-toggle"
                                       data-target="@day" checked />
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="col-time">
                            <input type="time" name="WeekSchedule[@day].StartTime" class="form-control time-input"
                                   data-day="@day" value="09:00" />
                        </div>

                        <div class="col-time">
                            <input type="time" name="WeekSchedule[@day].EndTime" class="form-control time-input"
                                   data-day="@day" value="17:00" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Schedule</button>
        </div>
    </form>
</div>

<script>
    document.querySelectorAll('.day-toggle').forEach(toggle => {
        toggle.addEventListener('change', function () {
            const day = this.getAttribute('data-target');
            const inputs = document.querySelectorAll(`input[data-day="${day}"]`);
            inputs.forEach(input => {
                input.disabled = !this.checked;
                input.style.opacity = this.checked ? '1' : '0.3';
            });
        });
    });
</script>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    .form-container {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 30px;
        max-width: 900px;
    }

    .form-group {
        margin-bottom: 25px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .required {
        color: #dc3545;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

    /* ===== Days Section ===== */
    .days-section h2 {
        color: #d4af37;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 6px 0;
    }

    .section-subtitle {
        color: #888;
        font-size: 13px;
        margin: 0 0 20px 0;
    }

    .days-table {
        background-color: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        overflow: hidden;
    }

    .days-header,
    .day-row {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1.2fr 1.2fr;
        gap: 15px;
        padding: 14px 18px;
        align-items: center;
    }

    .days-header {
        background-color: #151515;
        border-bottom: 1px solid #2a2a2a;
    }

        .days-header > div {
            color: #d4af37;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

    .day-row {
        border-bottom: 1px solid #1c1c1c;
    }

        .day-row:last-child {
            border-bottom: none;
        }

    .day-name {
        color: #fff;
        font-size: 14px;
        font-weight: 600;
    }

    /* ===== Toggle Switch ===== */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #333;
        border-radius: 24px;
        transition: 0.3s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: #888;
            border-radius: 50%;
            transition: 0.3s;
        }

    .toggle-switch input:checked + .slider {
        background-color: rgba(212, 175, 55, 0.3);
    }

        .toggle-switch input:checked + .slider:before {
            transform: translateX(20px);
            background-color: #d4af37;
        }

    .time-input {
        padding: 8px 12px;
        font-size: 13px;
    }

    /* ===== Form Actions ===== */
    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 30px;
    }

    .btn {
        padding: 12px 26px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>