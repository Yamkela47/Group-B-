<script>
    document.querySelectorAll('.day-toggle').forEach(toggle => {
        const day = toggle.getAttribute('data-target');
        const inputs = document.querySelectorAll(`input[data-day="${day}"]`);
        function syncTimes() {
            inputs.forEach(input => {
                input.disabled = toggle.disabled || !toggle.checked;
                input.style.opacity = input.disabled ? '0.4' : '1';
            });
        }
        toggle.addEventListener('change', syncTimes);
        syncTimes();
    });
    function showDeleteConfirm() { document.getElementById('deleteModal').style.display = 'flex'; }
    function hideDeleteConfirm() { document.getElementById('deleteModal').style.display = 'none'; }
</script>