@using CuttingEdge.ManagerPortal.Models
@model CuttingEdge.ManagerPortal.ViewModels.ScheduleViewModel

@{
    ViewData["Title"] = "Edit Schedule";
    Layout = "_Layout";

    var bookings = ViewBag.Bookings as List<Booking>;
    var pendingLeave = ViewBag.PendingLeaveGroups as List<LeaveRequestGroup>
                       ?? new List<LeaveRequestGroup>();
    var thisMonday = DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));
    var hasPrevious = Model.WeekStart > thisMonday;
    var hasNext = Model.WeekStart < thisMonday.AddDays(49);
    var previousWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
}

<div class="page-header">
    <p class="breadcrumb">Schedule > Edit Schedule</p>
    <p class="subtitle">Manage working hours for the actual dates of the selected week.</p>
    <p class="subtitle" style="color:#d4af37;">Blocked dates are automatically Off; their reasons appear below each date. Days with active bookings cannot be changed.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (pendingLeave.Any())
{
    <div style="background:#1f1a0d;border:1px solid #d4af37;border-radius:11px;padding:15px 18px;margin-bottom:18px;">
        <strong style="color:#f0d06b;">&#9888; New notification: pending leave / blocked-date request</strong>
        <ul style="margin:8px 0 0;padding-left:20px;color:#ddd;font-size:13px;">
            @foreach (var g in pendingLeave)
            {
                <li style="margin-bottom:6px;">
                    <span style="color:#f0d06b;">@g.RangeLabel</span>
                    <span style="color:#888;">(@g.TypeLabel)</span> — @g.Reason
                    <div style="margin-top:4px;display:flex;gap:8px;">
                        @if (g.EnquiryId > 0)
                        {
                            <a asp-controller="Enquiries" asp-action="Details" asp-route-id="@g.EnquiryId"
                               style="display:inline-block;padding:5px 12px;border:1px solid #d4af37;border-radius:6px;color:#d4af37;text-decoration:none;font-size:12px;">
                                Review request &amp; decide
                            </a>
                        }
                        else
                        {
                            <span style="color:#ff9fa6;font-size:12px;">Enquiry link not found — open Enquiries to review.</span>
                        }
                    </div>
                </li>
            }
        </ul>
        <a asp-controller="Enquiries" asp-action="Index" style="color:#d4af37;font-size:13px;">Review in Enquiries →</a>
    </div>
}

<div class="edit-grid">

    <div class="schedule-card">
        <form asp-action="Edit" asp-route-stylistId="@Model.StylistId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StylistId" />
            <input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />

            <div class="form-group">
                <label>Stylist</label>
                <input type="text" class="form-control" value="@Model.StylistName" readonly />
            </div>

            <div class="days-section">
                <div class="week-toolbar">
                    <div>
                        <h2>Working hours for this week</h2>
                        <p class="week-range">@Model.WeekStart.ToString("dd MMM") – @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy")</p>
                    </div>
                    <nav class="week-nav" aria-label="Navigate schedule weeks">
                        @if (hasPrevious)
                        {
                            <a asp-action="Edit" asp-route-stylistId="@Model.StylistId" asp-route-week="@previousWeek">&larr; Previous</a>
                        }
                        @if (hasNext)
                        {
                            <a asp-action="Edit" asp-route-stylistId="@Model.StylistId" asp-route-week="@nextWeek">Next &rarr;</a>
                        }
                    </nav>
                </div>
                <p class="section-subtitle">Each switch applies to the date shown, not every occurrence of that weekday. Blocked and booked dates are protected.</p>

                <div class="days-table">
                    <div class="days-header">
                        <div class="col-day">Date</div>
                        <div class="col-status">Status</div>
                        <div class="col-time">Start Time</div>
                        <div class="col-time">End Time</div>
                    </div>

                    @for (int i = 0; i < Model.DateRows.Count; i++)
                    {
                        var day = Model.DateRows[i];
                        var protectedDate = day.IsBlocked || day.HasBooking || day.IsPast;
                        var displayEnabled = !day.IsBlocked && day.Enabled;
                        var reason = day.BlockedReason ?? "No reason provided";
                        if (reason.Equals("person leave", StringComparison.OrdinalIgnoreCase)) reason = "Personal leave";
                        var toggleId = $"scheduleDay{i}";
                        <div class="day-row @(day.IsBlocked ? "blocked-week-row" : "")">
                            <input type="hidden" name="DateRows[@i].Date" value="@day.Date.ToString("yyyy-MM-dd")" />
                            <div class="col-day">
                                <span class="day-name">@day.Date.ToString("dddd")</span>
                                <small class="day-full-date">@day.Date.ToString("dd MMM yyyy")</small>
                                @if (day.IsBlocked)
                                {
                                    <small class="day-specific-off">Unavailable — @reason</small>
                                }
                                else if (day.HasBooking)
                                {
                                    <small class="day-booked-note">Booking protected</small>
                                }
                                else if (day.IsPast)
                                {
                                    <small class="day-past-note">Past date</small>
                                }
                            </div>
                            <div class="col-status">
                                <label class="toggle-switch" for="@toggleId" title="@(day.IsBlocked ? "Blocked by the stylist" : day.HasBooking ? "Booking protected" : day.IsPast ? "Past date" : "Edit availability")">
                                    <input id="@toggleId" type="checkbox"
                                           name="DateRows[@i].Enabled"
                                           value="true"
                                           class="day-toggle"
                                           data-target="@i"
                                           checked="@displayEnabled"
                                           disabled="@protectedDate"
                                           aria-label="@day.Date.ToString("dd MMM yyyy") available" />
                                    <span class="slider"></span>
                                </label>
                                @if (day.IsBlocked)
                                {
                                    <small class="status-off">Off</small>
                                }
                            </div>
                            <div class="col-time">
                                <input type="time" name="DateRows[@i].StartTime" class="form-control time-input"
                                       data-day="@i" value="@day.StartTime" disabled="@(protectedDate || !displayEnabled)" />
                            </div>
                            <div class="col-time">
                                <input type="time" name="DateRows[@i].EndTime" class="form-control time-input"
                                       data-day="@i" value="@day.EndTime" disabled="@(protectedDate || !displayEnabled)" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-danger" onclick="showDeleteConfirm()">Delete Schedule</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>

    <div class="bookings-card">
        <h2>Incomplete bookings - whole week</h2>
        <p class="section-subtitle">@(bookings?.Count ?? 0) incomplete appointment(s) &middot; completed ones are removed from this schedule</p>

        @if (bookings != null && bookings.Any())
        {
            <div class="bookings-table">
                <div class="bookings-header">
                    <div>Date</div><div>Time</div><div>Customer</div><div>Service</div><div>Status</div>
                </div>
                @foreach (var booking in bookings)
                {
                    <div class="booking-row">
                        <div>@booking.AppointmentDate.ToString("ddd dd MMM")</div>
                        <div>@booking.StartTime.ToString(@"hh\:mm")</div>
                        <div>@booking.Customer?.FullName</div>
                        <div>@booking.Service?.Name</div>
                        <div class="status-cell">
                            <span class="status-badge incomplete">Incomplete</span>
                            <form asp-controller="Bookings" asp-action="Complete" asp-route-id="@booking.BookingId" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="mini-complete" title="Mark this appointment as completed">&#10003; Done</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-bookings"><p>No incomplete bookings for this week.</p></div>
        }
    </div>

</div>

<div id="deleteModal" class="modal" style="display:none;">
    <div class="modal-content">
        <h3>Delete Schedule?</h3>
        <p>Are you sure you want to delete this stylist's schedule? This cannot be undone.</p>
        <form asp-action="Delete" asp-route-stylistId="@Model.StylistId" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="hideDeleteConfirm()">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

