@model CuttingEdge.ManagerPortal.ViewModels.ScheduleViewModel

@{
    ViewData["Title"] = "Edit Schedule";
    Layout = "_Layout";

    var stylists = ViewBag.Stylists as List<CuttingEdge.ManagerPortal.Models.Stylist>;
    var bookings = ViewBag.Bookings as List<CuttingEdge.ManagerPortal.Models.Booking>;
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
}

<div class="page-header">
    <p class="breadcrumb">Schedule > Edit Schedule</p>
    <h1>Edit Schedule</h1>
    <p class="subtitle">View the bookings and update the working hours for this stylist.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="edit-grid">

    <!-- Left: Schedule Editor -->
    <div class="schedule-card">
        <form asp-action="Edit" asp-route-stylistId="@Model.StylistId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StylistId" />

            <div class="form-group">
                <label>Stylist</label>
                <input type="text" class="form-control" value="@Model.StylistName" readonly />
            </div>

            <div class="days-section">
                <h2>Set hours for each day</h2>
                <p class="section-subtitle">Toggle a day on to set its own start and end time.</p>

                <div class="days-table">
                    <div class="days-header">
                        <div class="col-day">Day</div>
                        <div class="col-status">Status</div>
                        <div class="col-time">Start Time</div>
                        <div class="col-time">End Time</div>
                    </div>

                    @foreach (var day in days)
                    {
                        var daySchedule = Model.WeekSchedule.ContainsKey(day)
                        ? Model.WeekSchedule[day]
                        : new CuttingEdge.ManagerPortal.ViewModels.DaySchedule();

                        <div class="day-row">
                            <div class="col-day">
                                <span class="day-name">@day</span>
                            </div>

                            <div class="col-status">
                                <label class="toggle-switch">
                                    <input type="checkbox"
                                           name="WeekSchedule[@day].Enabled"
                                           value="true"
                                           class="day-toggle"
                                           data-target="@day"
                                           checked="@daySchedule.Enabled" />
                                    <span class="slider"></span>
                                </label>
                            </div>

                            <div class="col-time">
                                <input type="time"
                                       name="WeekSchedule[@day].StartTime"
                                       class="form-control time-input"
                                       data-day="@day"
                                       value="@(daySchedule.StartTime ?? "09:00")" />
                            </div>

                            <div class="col-time">
                                <input type="time"
                                       name="WeekSchedule[@day].EndTime"
                                       class="form-control time-input"
                                       data-day="@day"
                                       value="@(daySchedule.EndTime ?? "17:00")" />
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-danger" onclick="showDeleteConfirm()">Delete Schedule</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>

    <!-- Right: Customer Bookings -->
    <div class="bookings-card">
        <h2>Incomplete bookings - whole week</h2>
        <p class="section-subtitle">@(bookings?.Count ?? 0) incomplete appointment(s) &middot; completed ones are removed from this schedule</p>

        @if (bookings != null && bookings.Any())
        {
            <div class="bookings-table">
                <div class="bookings-header">
                    <div>Date</div>
                    <div>Time</div>
                    <div>Customer</div>
                    <div>Service</div>
                    <div>Status</div>
                </div>

                @foreach (var booking in bookings)
                {
                    <div class="booking-row">
                        <div>@booking.AppointmentDate.ToString("ddd dd MMM")</div>
                        <div>@booking.StartTime.ToString(@"hh\:mm")</div>
                        <div>@booking.Customer?.FullName</div>
                        <div>@booking.Service?.Name</div>
                        <div class="status-cell">
                            <span class="status-badge incomplete">Incomplete</span>
                            <form asp-controller="Bookings" asp-action="Complete" asp-route-id="@booking.BookingId" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="mini-complete" title="Mark this appointment as completed">&#10003; Done</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-bookings">
                <p>No incomplete bookings for this week.</p>
            </div>
        }
    </div>

</div>

<!-- Delete Confirmation Modal (hidden) -->
<div id="deleteModal" class="modal" style="display:none;">
    <div class="modal-content">
        <h3>Delete Schedule?</h3>
        <p>Are you sure you want to delete this stylist's schedule? This cannot be undone.</p>
        <form asp-action="Delete" asp-route-stylistId="@Model.StylistId" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="hideDeleteConfirm()">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelectorAll('.day-toggle').forEach(toggle => {
        toggle.addEventListener('change', function () {
            const day = this.getAttribute('data-target');
            const inputs = document.querySelectorAll(`input[data-day="${day}"]`);
            inputs.forEach(input => {
                input.disabled = !this.checked;
                input.style.opacity = this.checked ? '1' : '0.3';
            });
        });

        // Run once on load
        const day = toggle.getAttribute('data-target');
        const inputs = document.querySelectorAll(`input[data-day="${day}"]`);
        inputs.forEach(input => {
            input.disabled = !toggle.checked;
            input.style.opacity = toggle.checked ? '1' : '0.3';
        });
    });

    function showDeleteConfirm() {
        document.getElementById('deleteModal').style.display = 'flex';
    }

    function hideDeleteConfirm() {
        document.getElementById('deleteModal').style.display = 'none';
    }
</script>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    /* ===== Grid ===== */
    .edit-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 22px;
    }

    @@media (max-width: 1100px) {
        .edit-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Cards ===== */
    .schedule-card,
    .bookings-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 28px;
    }

        .bookings-card h2 {
            color: #d4af37;
            font-size: 16px;
            font-weight: 700;
            margin: 0 0 6px 0;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 11px 14px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

        .form-control[readonly] {
            color: #888;
            cursor: not-allowed;
        }

    /* ===== Days Table ===== */
    .days-section h2 {
        color: #d4af37;
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 6px 0;
    }

    .section-subtitle {
        color: #888;
        font-size: 12px;
        margin: 0 0 18px 0;
    }

    .days-table {
        background-color: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .days-header,
    .day-row {
        display: grid;
        grid-template-columns: 1.4fr 0.8fr 1.2fr 1.2fr;
        gap: 12px;
        padding: 12px 16px;
        align-items: center;
    }

    .days-header {
        background-color: #151515;
        border-bottom: 1px solid #2a2a2a;
    }

        .days-header > div {
            color: #d4af37;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

    .day-row {
        border-bottom: 1px solid #1c1c1c;
    }

        .day-row:last-child {
            border-bottom: none;
        }

    .day-name {
        color: #fff;
        font-size: 13px;
        font-weight: 600;
    }

    /* ===== Toggle Switch ===== */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #333;
        border-radius: 22px;
        transition: 0.3s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 3px;
            bottom: 3px;
            background-color: #888;
            border-radius: 50%;
            transition: 0.3s;
        }

    .toggle-switch input:checked + .slider {
        background-color: rgba(212, 175, 55, 0.3);
    }

        .toggle-switch input:checked + .slider:before {
            transform: translateX(18px);
            background-color: #d4af37;
        }

    .time-input {
        padding: 8px 10px;
        font-size: 12px;
    }

    /* ===== Bookings Table ===== */
    .bookings-table {
        background-color: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 10px;
        overflow: hidden;
    }

    .bookings-header,
    .booking-row {
        display: grid;
        grid-template-columns: 1.1fr 0.7fr 1.2fr 1.3fr 1fr;
        gap: 10px;
        padding: 12px 16px;
        align-items: center;
        font-size: 12px;
    }

    .bookings-header {
        background-color: #151515;
        border-bottom: 1px solid #2a2a2a;
    }

        .bookings-header > div {
            color: #d4af37;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .booking-row {
        color: #ddd;
        border-bottom: 1px solid #1c1c1c;
    }

        .booking-row:last-child {
            border-bottom: none;
        }

    .status-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 700;
        text-transform: capitalize;
    }

        .status-badge.completed {
            background-color: rgba(40, 167, 69, 0.15);
            color: #28a745;
            border: 1px solid #28a745;
        }

        .status-badge.pending {
            background-color: rgba(255, 193, 7, 0.15);
            color: #ffc107;
            border: 1px solid #ffc107;
        }

        .status-badge.confirmed {
            background-color: rgba(23, 162, 184, 0.15);
            color: #17a2b8;
            border: 1px solid #17a2b8;
        }

        .status-badge.cancelled {
            background-color: rgba(220, 53, 69, 0.15);
            color: #dc3545;
            border: 1px solid #dc3545;
        }

    .empty-bookings {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-bookings p {
            color: #666;
            font-style: italic;
            font-size: 13px;
            margin: 0;
        }

    /* ===== Buttons ===== */
    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .btn {
        padding: 11px 22px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
        text-align: center;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            color: #0d0d0d;
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    .btn-danger {
        background-color: transparent;
        border: 1px solid #dc3545;
        color: #dc3545;
    }

        .btn-danger:hover {
            background-color: #dc3545;
            color: #fff;
        }

    /* ===== Modal ===== */
    .modal {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
        max-width: 400px;
        width: 90%;
    }

        .modal-content h3 {
            color: #dc3545;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 10px 0;
        }

        .modal-content p {
            color: #aaa;
            font-size: 14px;
            line-height: 1.5;
            margin: 0 0 22px 0;
        }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }

    .status-badge.incomplete {
        background-color: rgba(212, 175, 55, 0.08);
        color: #d4af37;
        border: 1px solid #d4af37;
    }

    .status-cell { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .status-cell form { margin: 0; }

    .mini-complete {
        background: transparent;
        color: #28a745;
        border: 1px solid #28a745;
        border-radius: 14px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }
    .mini-complete:hover { background: rgba(40, 167, 69, 0.15); }
</style>