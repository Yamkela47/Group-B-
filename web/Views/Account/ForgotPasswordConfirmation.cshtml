@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_Layout";
}

<div class="confirmation-container">
    <div class="confirmation-card">
        <div class="confirmation-icon">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div class="checkmark">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#28a745" stroke-width="3">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>
        </div>

        <h2>Check your email</h2>
        <p class="description">We've sent a password reset link to your email address.</p>

        <div class="info-box">
            <p>The link will expire in <strong>15 minutes</strong>. If you don't see it, please check your spam or junk folder.</p>
        </div>

        <div class="resend-section">
            <p>Didn't receive the email?</p>
            <a asp-controller="Account" asp-action="ForgotPassword" class="resend-link">Resend</a>
        </div>

        <a href="mailto:" class="btn btn-primary btn-block">Open Email App</a>

        <div class="form-footer">
            <a asp-controller="Account" asp-action="Login">← Back to Login</a>
        </div>
    </div>
</div>

<style>
    .confirmation-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #0d0d0d;
        padding: 20px;
    }

    .confirmation-card {
        background-color: #1a1a1a;
        border: 1px solid #d4af37;
        border-radius: 16px;
        padding: 40px;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
        text-align: center;
    }

    .confirmation-icon {
        position: relative;
        display: inline-block;
        margin-bottom: 20px;
    }

    .checkmark {
        position: absolute;
        bottom: -5px;
        right: -10px;
        background-color: #1a1a1a;
        border-radius: 50%;
        padding: 3px;
    }

    .confirmation-card h2 {
        color: #fff;
        font-size: 26px;
        font-weight: 700;
        margin: 10px 0;
    }

    .description {
        color: #aaa;
        font-size: 14px;
        margin-bottom: 25px;
        line-height: 1.5;
    }

    .info-box {
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 25px;
    }

        .info-box p {
            color: #aaa;
            font-size: 13px;
            margin: 0;
            line-height: 1.6;
        }

        .info-box strong {
            color: #d4af37;
        }

    .resend-section {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
        font-size: 14px;
    }

        .resend-section p {
            color: #888;
            margin: 0;
        }

    .resend-link {
        color: #d4af37;
        text-decoration: none;
        font-weight: 600;
    }

        .resend-link:hover {
            text-decoration: underline;
        }

    .btn-primary {
        width: 100%;
        padding: 14px;
        background-color: #d4af37;
        border: none;
        border-radius: 8px;
        color: #0d0d0d;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: block;
        box-sizing: border-box;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
            color: #0d0d0d;
            text-decoration: none;
        }

    .form-footer {
        margin-top: 20px;
    }

        .form-footer a {
            color: #d4af37;
            text-decoration: none;
            font-size: 14px;
        }

            .form-footer a:hover {
                text-decoration: underline;
            }
</style>