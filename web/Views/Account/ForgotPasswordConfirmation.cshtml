@{
    ViewData["Title"] = "Verify Password Reset Code";
    Layout = "_Layout";
    var email = ViewBag.RecoveryEmail as string ?? "";
}
<div class="ce-otp-page">
    <section class="ce-otp-card">
        <img class="ce-otp-logo" src="~/images/cutting-edge-logo.jpeg" alt="Cutting Edge Salon" />
        <h1>VERIFY YOUR EMAIL</h1>
        <p class="ce-otp-subtitle">Enter the six-digit code sent to your email and create a new manager password.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="ce-otp-error" role="alert">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPasswordConfirmation" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <label for="recoveryEmail">Manager email</label>
            <input type="email" id="recoveryEmail" name="email" value="@email"
                   autocomplete="username email" maxlength="320" required readonly />

            <label for="code">Verification code</label>
            <input id="code" name="code" type="text" inputmode="numeric"
                   pattern="[0-9]{6}" minlength="6" maxlength="6"
                   placeholder="6-digit code" autocomplete="one-time-code" required />

            <label for="newPassword">New password</label>
            <div class="ce-pw-wrap">
                <input id="newPassword" name="newPassword" type="password"
                       minlength="8" maxlength="128" autocomplete="new-password" required />
                <button type="button" class="ce-pw-toggle" data-target="newPassword" aria-label="Show password" aria-pressed="false" title="Show / hide password">
                    <svg class="icon-show" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                    <svg class="icon-hide" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                </button>
            </div>

            <label for="confirmPassword">Confirm new password</label>
            <div class="ce-pw-wrap">
                <input id="confirmPassword" name="confirmPassword" type="password"
                       minlength="8" maxlength="128" autocomplete="new-password" required />
                <button type="button" class="ce-pw-toggle" data-target="confirmPassword" aria-label="Show password" aria-pressed="false" title="Show / hide password">
                    <svg class="icon-show" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                    <svg class="icon-hide" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /><line x1="1" y1="1" x2="23" y2="23" /></svg>
                </button>
            </div>

            <p class="ce-otp-hint">Choose a unique password with at least 8 characters. The emailed code expires after 10 minutes and can be used once. After five incorrect attempts, request a new code.</p>
            <button type="submit">Verify Code &amp; Update Password</button>
        </form>

        <div class="ce-otp-links">
            <a asp-controller="Account" asp-action="ForgotPassword">Request a new code</a>
            <a asp-controller="Account" asp-action="Login">Back to Login</a>
        </div>
    </section>
</div>
<script>
    document.querySelectorAll('.ce-pw-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = document.getElementById(btn.getAttribute('data-target'));
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.parentElement.classList.toggle('is-visible', show);
            btn.setAttribute('aria-pressed', show ? 'true' : 'false');
            btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            input.focus();
        });
    });
</script>
<style>
    .ce-otp-page {
        min-height: 100vh;
        background: #0d0d0d;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .ce-otp-card {
        width: 100%;
        max-width: 470px;
        background: #1a1a1a;
        border: 1px solid #d4af37;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 0 28px #d4af3722;
    }

    .ce-otp-logo {
        width: 76px;
        height: 76px;
        object-fit: cover;
        display: block;
        margin: 0 auto 14px;
        border-radius: 50%;
        border: 2px solid #d4af37;
    }

    .ce-otp-card h1 {
        text-align: center;
        color: #d4af37;
        font-size: 23px;
        letter-spacing: 2px;
        margin: 0 0 12px;
    }

    .ce-otp-subtitle {
        color: #bbb;
        font-size: 14px;
        text-align: center;
        line-height: 1.5;
        margin: 0 0 24px;
    }

    .ce-otp-card label {
        display: block;
        color: #d4af37;
        font-size: 13px;
        font-weight: 700;
        margin: 16px 0 6px;
    }

    .ce-otp-card input {
        width: 100%;
        background: #0a0a0a;
        border: 1px solid #555;
        color: white;
        border-radius: 8px;
        padding: 13px 14px;
        outline: none;
    }

        .ce-otp-card input:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 2px #d4af3733;
        }

        .ce-otp-card input[readonly] {
            color: #b9b9b9;
        }

    .ce-otp-hint {
        color: #999;
        font-size: 12px;
        margin: 15px 0 18px;
        line-height: 1.55;
    }

    .ce-otp-card button {
        background: #d4af37;
        color: #080808;
        border: none;
        font-size: 15px;
        font-weight: 800;
        border-radius: 8px;
        padding: 14px;
        width: 100%;
        cursor: pointer;
    }

        .ce-otp-card button:hover {
            background: #f3d05b;
        }

    .ce-otp-error {
        color: #ffb3b3;
        background: #3a191b;
        border: 1px solid #ad353a;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 18px;
        font-size: 13px;
    }

        .ce-otp-error ul {
            margin: 0;
            padding-left: 18px;
        }

    .ce-otp-links {
        display: flex;
        gap: 16px;
        justify-content: space-between;
        flex-wrap: wrap;
        margin-top: 22px;
    }

        .ce-otp-links a {
            color: #d4af37;
            font-size: 13px;
            text-decoration: none;
        }

    /* Show / hide password */
    .ce-pw-wrap {
        position: relative;
    }

    .ce-otp-card .ce-pw-wrap input {
        padding-right: 48px;
    }

    .ce-otp-card .ce-pw-wrap .ce-pw-toggle {
        position: absolute;
        top: 50%;
        right: 6px;
        transform: translateY(-50%);
        width: 38px;
        height: 38px;
        padding: 0;
        background: transparent;
        color: #d4af37;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .ce-otp-card .ce-pw-wrap .ce-pw-toggle:hover {
            background: #d4af3722;
            color: #f3d05b;
        }

    .ce-pw-wrap .icon-hide {
        display: none;
    }

    .ce-pw-wrap.is-visible .icon-show {
        display: none;
    }

    .ce-pw-wrap.is-visible .icon-hide {
        display: block;
    }
</style>
