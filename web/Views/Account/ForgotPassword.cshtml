@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="forgot-container">
    <div class="forgot-card">
        <div class="forgot-header">
            <img src="~/images/cutting-edge-logo.jpeg" alt="Cutting Edge Logo" class="forgot-logo" />
            <h1>CUTTING EDGE</h1>
            <p class="subtitle">OUR VISION. YOUR STYLE</p>
        </div>

        <div class="forgot-icon">
            <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
        </div>

        <h2>Forgot Password?</h2>
        <p class="description">No worries! Enter the email address linked to your account and we'll send you a password reset link.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="forgot-form">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            }

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-control" placeholder="Enter your email address" required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>

            <div class="divider">
                <span>OR</span>
            </div>

            <div class="form-footer">
                <a asp-controller="Account" asp-action="Login">Back to Login</a>
            </div>
        </form>

        <div class="help-section">
            <h4>Need help?</h4>
            <p>If you no longer have access to this email please contact our support team</p>
        </div>
    </div>
</div>

<style>
    .forgot-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #0d0d0d;
        padding: 20px;
    }

    .forgot-card {
        background-color: #1a1a1a;
        border: 1px solid #d4af37;
        border-radius: 16px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
        text-align: center;
    }

    .forgot-header h1 {
        color: #d4af37;
        font-size: 24px;
        font-weight: 700;
        margin: 0;
        letter-spacing: 2px;
    }

    .forgot-header .subtitle {
        color: #888;
        font-size: 11px;
        letter-spacing: 3px;
        margin: 5px 0 0 0;
    }

    .forgot-logo {
        width: 70px;
        height: 70px;
        margin-bottom: 10px;
        border-radius: 50%;
        border: 2px solid #d4af37;
    }

    .forgot-icon {
        margin: 20px 0;
        display: flex;
        justify-content: center;
    }

    .forgot-card h2 {
        color: #fff;
        font-size: 22px;
        font-weight: 600;
        margin: 10px 0;
    }

    .description {
        color: #aaa;
        font-size: 14px;
        margin-bottom: 25px;
        line-height: 1.5;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: 500;
        }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #d4af37;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #f0d060;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

        .form-control::placeholder {
            color: #555;
        }

    .btn-primary {
        width: 100%;
        padding: 14px;
        background-color: #d4af37;
        border: none;
        border-radius: 8px;
        color: #0d0d0d;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .divider {
        display: flex;
        align-items: center;
        margin: 20px 0;
        color: #555;
        font-size: 12px;
    }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background-color: #333;
        }

        .divider span {
            padding: 0 15px;
        }

    .form-footer a {
        color: #d4af37;
        text-decoration: none;
        font-size: 14px;
    }

        .form-footer a:hover {
            text-decoration: underline;
        }

    .help-section {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #333;
        text-align: left;
    }

        .help-section h4 {
            color: #d4af37;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .help-section p {
            color: #888;
            font-size: 12px;
            margin: 0;
            line-height: 1.5;
        }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 20px;
        color: #ff6b6b;
        font-size: 14px;
        text-align: left;
    }
</style>