@{
    ViewData["Title"] = "Manager Login";
    Layout = "_Layout";
}

<div class="login-container">

    <!-- Back Button -->
    <a asp-controller="Home" asp-action="Welcome" class="back-btn">
        <span class="back-arrow">←</span> Back
    </a>

    <div class="login-card">
        <div class="login-header">
            <img src="~/images/cutting-edge-logo.jpeg" alt="Cutting Edge Logo" class="login-logo" />
            <h1>CUTTING EDGE</h1>
            <p class="subtitle">SALON MANAGEMENT SYSTEM</p>
            <h2>Staff / Manager Login</h2>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
            }

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-control"
                       placeholder="manager@example.com" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" class="form-control"
                       placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">Sign In</button>

            <div class="form-footer">
                <a asp-controller="Account" asp-action="ForgotPassword">Forgot password</a>
            </div>
        </form>
    </div>
</div>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #0d0d0d;
        position: relative; /* ← needed so back-btn anchors correctly */
        padding: 40px 20px;
    }

    /* ===== Back Button ===== */
    .back-btn {
        position: absolute;
        top: 30px;
        left: 30px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background-color: transparent;
        border: 1px solid #d4af37;
        border-radius: 8px;
        color: #d4af37;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .back-btn:hover {
            background-color: #d4af37;
            color: #0d0d0d;
            text-decoration: none;
            transform: translateX(-2px);
        }

    .back-arrow {
        font-size: 16px;
        font-weight: 700;
        transition: transform 0.3s ease;
    }

    .back-btn:hover .back-arrow {
        transform: translateX(-2px);
    }

    /* ===== Login Card ===== */
    .login-card {
        background-color: #1a1a1a;
        border: 1px solid #d4af37;
        border-radius: 16px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-logo {
        width: 80px;
        height: 80px;
        margin-bottom: 15px;
        border-radius: 50%;
        border: 2px solid #d4af37;
        object-fit: cover;
    }

    .login-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
        letter-spacing: 2px;
    }

    .login-header .subtitle {
        color: #888;
        font-size: 12px;
        letter-spacing: 3px;
        margin: 5px 0 20px 0;
    }

    .login-header h2 {
        color: #fff;
        font-size: 20px;
        font-weight: 500;
        margin: 0;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: 500;
        }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #d4af37;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        transition: all 0.3s ease;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #f0d060;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

        .form-control::placeholder {
            color: #555;
        }

    .btn-primary {
        width: 100%;
        padding: 14px;
        background-color: #d4af37;
        border: none;
        border-radius: 8px;
        color: #0d0d0d;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 10px;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-block {
        display: block;
    }

    .form-footer {
        text-align: center;
        margin-top: 20px;
    }

        .form-footer a {
            color: #d4af37;
            text-decoration: none;
            font-size: 14px;
        }

            .form-footer a:hover {
                text-decoration: underline;
            }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 20px;
        color: #ff6b6b;
        font-size: 14px;
    }

    /* ===== Mobile responsive ===== */
    @@media (max-width: 600px) {
        .back-btn {
            top: 15px;
            left: 15px;
            padding: 8px 14px;
            font-size: 13px;
        }
    }
</style>