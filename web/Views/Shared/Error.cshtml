@model CuttingEdge.ManagerPortal.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="error-container">
    <div class="error-card">
        <div class="error-icon">⚠</div>
        <h1>Something went wrong</h1>
        <p class="error-message">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <div class="error-detail">
                <strong>Request ID:</strong>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                ← Back to Dashboard
            </a>
            <a href="javascript:location.reload()" class="btn btn-secondary">
                Reload Page
            </a>
        </div>

        <div class="error-help">
            <p>
                If the problem persists, please contact the system administrator or
                <a href="mailto:cuttinged@88@gmail.com">cuttinged@88@gmail.com</a>.
            </p>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #0d0d0d;
    }

    .error-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .error-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 16px;
        padding: 50px 40px;
        max-width: 520px;
        width: 100%;
        text-align: center;
        box-shadow: 0 0 40px rgba(220, 53, 69, 0.08);
    }

    .error-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: rgba(220, 53, 69, 0.1);
        border: 2px solid #dc3545;
        color: #dc3545;
        font-size: 40px;
        margin-bottom: 20px;
    }

    .error-card h1 {
        color: #fff;
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 12px 0;
    }

    .error-message {
        color: #aaa;
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 25px 0;
    }

    .error-detail {
        background-color: #0d0d0d;
        border: 1px solid #2a2a2a;
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 25px;
        text-align: left;
        font-size: 13px;
    }

        .error-detail strong {
            color: #d4af37;
            margin-right: 8px;
        }

        .error-detail code {
            color: #bbb;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            word-break: break-all;
        }

    .error-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            color: #0d0d0d;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    .error-help {
        border-top: 1px solid #2a2a2a;
        padding-top: 20px;
    }

        .error-help p {
            color: #777;
            font-size: 12px;
            line-height: 1.6;
            margin: 0;
        }

        .error-help a {
            color: #d4af37;
            text-decoration: none;
        }

            .error-help a:hover {
                text-decoration: underline;
            }
</style>