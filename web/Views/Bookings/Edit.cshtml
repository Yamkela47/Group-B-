@model CuttingEdge.ManagerPortal.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
    Layout = "_Layout";
}

<div class="page-header">
    <p class="breadcrumb">Bookings > Edit Booking</p>
    <h1>Edit Booking</h1>
    <p class="subtitle">Update the booking information below.</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Edit" asp-route-id="@Model.BookingId" method="post" class="edit-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BookingId" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        </div>
    }

    <div class="form-grid">
        <div class="form-group">
            <label>Appointment Date</label>
            <input asp-for="AppointmentDate" type="date" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" required />
        </div>

        <div class="form-group">
            <label>End Time</label>
            <input asp-for="EndTime" type="time" class="form-control" required />
        </div>

        <div class="form-group">
            <label>Status</label>
            <select asp-for="Status" class="form-control">
                <option value="Incomplete">Incomplete</option>
                <option value="Completed">Completed</option>
            </select>
        </div>

        <div class="form-group full-width">
            <label>Additional Notes</label>
            <textarea asp-for="AdditionalNotes" class="form-control" rows="3" placeholder="Any additional notes..."></textarea>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<style>
    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    .edit-form {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

    textarea.form-control {
        resize: vertical;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
        }

    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>