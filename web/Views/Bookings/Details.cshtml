@model CuttingEdge.ManagerPortal.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
    Layout = "_Layout";
}

<div class="page-header">
    <p class="breadcrumb">Bookings > Booking Details</p>
    <p class="subtitle">View the complete booking information below.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="details-grid">
    <div class="detail-group">
        <label>Customer Name</label>
        <div class="detail-value">@Model.Customer?.FullName</div>
    </div>

    <div class="detail-group">
        <label>Customer Contact</label>
        <div class="detail-value">@Model.Customer?.Phone</div>
    </div>

    <div class="detail-group">
        <label>Service</label>
        <div class="detail-value">@Model.Service?.Name</div>
    </div>

    <div class="detail-group">
        <label>Stylist</label>
        <div class="detail-value">@Model.Stylist?.Profile?.FullName</div>
    </div>

    <div class="detail-group">
        <label>Date</label>
        <div class="detail-value">@Model.AppointmentDate.ToString("dd MMMM yyyy")</div>
    </div>

    <div class="detail-group">
        <label>Time</label>
        <div class="detail-value">@Model.StartTime.ToString(@"hh\:mm")</div>
    </div>

    <div class="detail-group">
        <label>Price (R)</label>
        <div class="detail-value">@Model.Service?.Price.ToString("N2")</div>
    </div>

    <div class="detail-group">
        <label>Payment Method</label>
        <div class="detail-value">@Model.PaymentMethod?.MethodName</div>
    </div>

    <div class="detail-group">
        <label>Status</label>
        <div class="detail-value">@Model.Status</div>
    </div>
</div>

<div class="detail-group full-width">
    <label>Additional Notes (from customer)</label>
    <div class="detail-value notes">@(Model.AdditionalNotes ?? "No additional notes provided.")</div>
</div>

@if (Model.Status == "Cancelled")
{
    <div class="detail-group full-width">
        <label style="margin-top:12px;">Cancellation Reason</label>
        <div class="detail-value notes">@(string.IsNullOrWhiteSpace(Model.Cancellation?.Reason) ? "No cancellation reason was recorded." : Model.Cancellation.Reason)</div>
    </div>
}

<!-- Action Buttons -->
<div class="action-buttons">
    @if (Model.Status == "Incomplete")
    {
        <details class="cancel-box">
            <summary class="btn btn-secondary">Cancel Appointment</summary>
            <form asp-action="Cancel" asp-route-id="@Model.BookingId" method="post">
                @Html.AntiForgeryToken()
                <label for="reason">Reason for cancellation (Manager)</label>
                <textarea id="reason" name="reason" required maxlength="1000" rows="3" class="cancel-reason" placeholder="Explain why this appointment is being cancelled"></textarea>
                <button type="submit" class="btn btn-danger" onclick="return confirm('Cancel this appointment?');">Confirm Cancellation</button>
            </form>
        </details>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to Bookings</a>
</div>

<style>
    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .detail-group {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 16px 20px;
    }

        .detail-group.full-width {
            grid-column: 1 / -1;
            margin-bottom: 25px;
        }

        .detail-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .detail-value {
        color: #fff;
        font-size: 15px;
        padding: 4px 0;
    }

        .detail-value.notes {
            color: #bbb;
            font-style: italic;
            line-height: 1.5;
        }

    .action-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .cancel-box {
        width: 100%;
        max-width: 550px;
    }

        .cancel-box summary {
            width: fit-content;
            cursor: pointer;
            list-style: none;
        }

        .cancel-box form {
            background: #1a1a1a;
            border: 1px solid #444;
            border-radius: 10px;
            margin-top: 10px;
            padding: 16px;
        }

        .cancel-box label {
            display: block;
            color: #d4af37;
            margin-bottom: 8px;
        }

    .cancel-reason {
        width: 100%;
        box-sizing: border-box;
        background: #111;
        color: #fff;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .btn-danger {
        background: #9f3333;
        color: #fff;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
            color: #0d0d0d;
            text-decoration: none;
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
            text-decoration: none;
        }

    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>