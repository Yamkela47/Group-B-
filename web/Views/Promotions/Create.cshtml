@model CuttingEdge.ManagerPortal.Models.Promotion

@{
    ViewData["Title"] = "New Promotion";
    Layout = "_Layout";
}

<div class="page-header">
    <p class="breadcrumb">Promotions > New Promotion</p>
    <h1>New Promotion</h1>
    <p class="subtitle">Create a new promotion to attract more clients and grow your business.</p>
</div>

<div class="form-container">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }

        <!-- Promotion Details -->
        <div class="form-section">
            <h2>Promotion Details</h2>

            <div class="form-group">
                <label>Promotion Title <span class="required">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="e.g., Summer Glow Special" required />
            </div>

            <div class="form-group">
                <label>Description <span class="required">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="4"
                          placeholder="Describe the promotion, discount, and any conditions..."></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Discount Type <span class="required">*</span></label>
                    <select asp-for="DiscountType" class="form-control" required>
                        <option value="">Select type</option>
                        <option value="Percentage">Percentage (%)</option>
                        <option value="Fixed">Fixed Amount (R)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Discount Value <span class="required">*</span></label>
                    <input asp-for="DiscountValue" type="number" step="0.01" min="0" class="form-control" placeholder="15" required />
                </div>
            </div>

            <div class="form-group">
                <label>Promotion Image (Optional)</label>
                <div class="upload-box">
                    <span class="upload-icon">☁</span>
                    <p class="upload-text">Click to upload image</p>
                    <p class="upload-hint">PNG, JPG (Max 5MB)</p>
                    <input type="file" name="imageFile" accept="image/png,image/jpeg" class="file-input" />
                </div>
            </div>
        </div>

        <!-- Applicability -->
        <div class="form-section">
            <h2>Applicability</h2>

            <div class="form-row">
                <div class="form-group">
                    <label>Promotion Type <span class="required">*</span></label>
                    <select class="form-control">
                        <option>Seasonal Promotion</option>
                        <option>Service Discount</option>
                        <option>Birthday Discount</option>
                        <option>Loyalty Promotion</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Applicable Service(s) <span class="required">*</span></label>
                    <select asp-for="ServiceId" class="form-control" required>
                        <option value="">Select a service</option>
                        @if (ViewBag.Services != null)
                        {
                            @foreach (var service in ViewBag.Services)
                            {
                                <option value="@service.ServiceId">@service.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Valid From <span class="required">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" required />
                </div>

                <div class="form-group">
                    <label>Valid To <span class="required">*</span></label>
                    <input asp-for="EndDate" type="date" class="form-control" required />
                </div>
            </div>

            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="Active" type="checkbox" checked />
                    <span class="checkbox-text">
                        <strong>Set as Active</strong>
                        <span class="hint">Active promotions will be visible to customers.</span>
                    </span>
                </label>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Create Promotion</button>
        </div>
    </form>
</div>

<style>
    body {
        background-color: #0d0d0d;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header h1 {
        color: #d4af37;
        font-size: 28px;
        font-weight: 700;
        margin: 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    .form-container {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 14px;
        padding: 35px;
        max-width: 900px;
    }

    .form-section {
        margin-bottom: 30px;
        padding-bottom: 25px;
        border-bottom: 1px solid #2a2a2a;
    }

        .form-section:last-of-type {
            border-bottom: none;
            padding-bottom: 0;
        }

        .form-section h2 {
            color: #d4af37;
            font-size: 17px;
            font-weight: 700;
            margin: 0 0 20px 0;
            letter-spacing: 0.5px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .required {
        color: #dc3545;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
        }

        .form-control::placeholder {
            color: #555;
        }

    textarea.form-control {
        resize: vertical;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    /* ===== Upload Box ===== */
    .upload-box {
        border: 2px dashed #444;
        border-radius: 10px;
        padding: 30px;
        text-align: center;
        background-color: #0d0d0d;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

        .upload-box:hover {
            border-color: #d4af37;
        }

    .upload-icon {
        font-size: 32px;
        display: block;
        margin-bottom: 10px;
    }

    .upload-text {
        color: #ddd;
        font-size: 14px;
        margin: 0;
        font-weight: 600;
    }

    .upload-hint {
        color: #666;
        font-size: 12px;
        margin: 4px 0 0 0;
    }

    .file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    /* ===== Checkbox ===== */
    .checkbox-group {
        margin-top: 15px;
    }

    .checkbox-label {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        cursor: pointer;
    }

        .checkbox-label input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-top: 2px;
            accent-color: #d4af37;
            cursor: pointer;
        }

    .checkbox-text {
        display: flex;
        flex-direction: column;
    }

        .checkbox-text strong {
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .checkbox-text .hint {
            color: #888;
            font-size: 12px;
        }

    /* ===== Form Actions ===== */
    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .btn {
        padding: 12px 26px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            transform: translateY(-1px);
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
        }

    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }
</style>